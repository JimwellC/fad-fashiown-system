# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.
# In production (Railway), set these as service environment variables instead.

# Flask session-signing key. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

FLASK_ENV=development
DEBUG=True

# Local dev uses SQLite; production overrides with the Railway PostgreSQL URL.
DATABASE_URL=sqlite:///database/fadfashiown.db

# ── Facebook webhook test (see docs/facebook-webhook-test.md) ──
# Only needed when receiving Facebook webhooks. Do NOT commit real values.
# FB_WEBHOOK_VERIFY_TOKEN=your-chosen-verify-token
# FB_APP_SECRET=your-facebook-app-secret
