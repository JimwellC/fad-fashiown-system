{
  "manifest_version": 3,
  "name": "Fad Fashiown - Pinned Comment Detector",
  "version": "1.0",
  "description": "Detects pinned comments on TikTok Live and sends to Fad Fashiown dashboard",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://www.tiktok.com/*",
    "http://localhost:5000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Fad Fashiown Detector"
  }
}